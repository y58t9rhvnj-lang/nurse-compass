        "cc733032-c8de-469b-b12e-7a32e674a81e",
        "0d9e1e78-f101-4c59-b85c-62c822ad3a4c"
      ],
      "needMoreInformation": "OTを辞退した日と前夜睡眠の対応、SSTで得ていると感じていること、促しなしでできるセルフケアの範囲。",
      "patternKey": "activity_exercise",
      "order": 4,
      "status": "reviewed",
      "createdAt": "2026-09-15T11:29:42.553Z",
      "updatedAt": "2026-09-15T11:59:32.997Z"
